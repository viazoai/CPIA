# Next.js (web/) 환경 변수
# 사용법: cp .env.local.example .env.local 후 값 채우기

# Postgres — homelab 의 cpia-postgres (이 머신에선 localhost, A 측은 cloudflared forward 후 localhost:5532)
POSTGRES_URL=postgresql://cpia:<password>@localhost:5532/cpia

# FastAPI — pipeline/api.py (A_Track 진척에 따라 활성화)
FASTAPI_URL=http://localhost:8000

# Exporter graph 통합 (2026-05-27 spec) — FastAPI base URL.
# 로컬: http://localhost:8000 / homelab: Cloudflare Tunnel 경유 도메인.
# NEXT_PUBLIC_* prefix 는 Next.js build time 에 client bundle 에 inline 됨 —
# 값 변경 시 반드시 `npm run dev` 재기동 (HMR 안 잡힘).
NEXT_PUBLIC_FASTAPI_BASE=http://localhost:8000

# 시연 데이터 초기화 버튼 노출 토글 (UserMenu 안 "시연 데이터 초기화").
# 1 이면 노출, 미설정/0 이면 숨김 (일반 사용자 비가시). 시연 호스트 / 개발 환경에만 1 로.
# 변경 후 dev / 컨테이너 재기동 필요 (NEXT_PUBLIC_* 는 build time inline).
NEXT_PUBLIC_DEMO_RESET=1

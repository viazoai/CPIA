# .env.local — CPIA 매핑 레이어 (로컬 Docker)
# 활성화: ln -sf .env.local .env

# Azure OpenAI (기존 .env 값 복사)
AZURE_OPENAI_ENDPOINT=https://skep-ai-board-for-test-foundry.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=8nEESj8jToVVnvEmHrQcACjMO20Kbrkx4C6luazLk8qeQZXbx8mdJQQJ99CCACNns7RXJ3w3AAAAACOGJhCX
AZURE_OPENAI_API_VERSION=2024-12-01-preview
LLM_MODEL=gpt-5.1-chat-ai-board-test
EMBEDDING_MODEL=text-embedding-3-small-ai-board-test
EMBEDDING_DIM=1536

# --- 로컬 dev (infra/local/docker-compose.local.yml) ---
POSTGRES_URL=postgresql://cpia:cpia@localhost:5432/cpia
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# --- Homelab (infra/docker-compose.yml + Cloudflare Tunnel) ---
# Zero Trust 대시보드에서 cpia tunnel 의 Public Hostname 등록 후:
#   - ChromaDB (HTTP, 가장 쉬움): Service Type=HTTP, URL=chroma:8000
#       → CHROMA_HOST=cpia-chroma.<your-domain>, CHROMA_PORT=443, CHROMA_SSL=true
#   - PostgreSQL (TCP): Service Type=TCP, URL=postgres:5432
#       → 노트북에서 `cloudflared access tcp --hostname cpia-pg.<your-domain> --url localhost:5532 &`
#       → POSTGRES_URL=postgresql://cpia:<password>@localhost:5532/cpia
# 활성화 시 위 로컬 dev 블록은 주석 처리 (dotenv 가 후순위 덮어쓰기).

# Environment variables (secrets)
.env
.env.local
.env.homelab
.env.backup-*
.env.local.*backup
.env.local.aws-backup
pipeline/.env
web/.env.local
infra/.env
*.bak

# Plugin runtime — brainstorming 세션 등
.superpowers/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
*.log
npm-debug.log*

# Data (runtime artifacts, not committed) — keep folder structure via .gitkeep
data/input/*
!data/input/.gitkeep
data/output/**
!data/output/reports/
!data/output/reports/.gitkeep
data/synthetic_history/*
!data/synthetic_history/.gitkeep
data/vector_db/
data/upload/
# parser recipe 런타임 캐시 산출물 (recipe 모듈 미배선 — 캐시 JSON 은 비추적)
data/parser_recipes/_review/
data/parser_recipes/*.json
# export PoC throwaway 산출물 (데모 정합 brainstorming 잔여)
web/public/poc_*.xlsx

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# 다른 세션 캡쳐 로그 + Playwright 결과
tmp/
tmp/*.sql
web/test-results/

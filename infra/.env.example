# infra/docker-compose 가 읽는 변수. 실제 값은 git 에 올리지 않는다.
# 사용법: cp .env.example .env 후 값 채우기.

POSTGRES_USER=cpia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cpia
POSTGRES_PORT=5532

CHROMA_PORT=5533

# Cloudflare Tunnel — Zero Trust 대시보드에서 cpia tunnel 생성 후
# Docker 옵션의 token 한 줄을 여기에. 채팅·git 에 절대 노출 금지.
CLOUDFLARED_TOKEN=

# CPIA 환경 변수 example
#
# 사용법:
#   1. cp .env.example .env.local
#   2. .env.local 의 <...> placeholder 를 실 값으로 채움
#   3. ln -sf .env.local .env   (conftest 가 루트 .env 를 load_dotenv)
#
# 시크릿 (AZURE_OPENAI_API_KEY / CLOUDFLARED_TOKEN / POSTGRES_PASSWORD) 은
# 절대 git / 채팅 / Slack 에 노출 금지. .gitignore 가 .env / .env.local 차단.

# --- Azure OpenAI (Mapper 의 임베딩 + LLM 호출) ---
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
LLM_MODEL=<your-llm-deployment-name>
EMBEDDING_MODEL=<your-embedding-deployment-name>
EMBEDDING_DIM=1536

# --- 로컬 인프라 (Task 0.5 Docker — infra/docker-compose.yml) ---
# 컨테이너: cpia-pg-local (5432), cpia-chroma-local (8000)
POSTGRES_URL=postgresql://cpia:cpia@localhost:5432/cpia
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Homelab Cloudflare Tunnel (optional, 외부 공유 시) ---
# Zero Trust 대시보드에서 cpia tunnel 생성 후 Docker 옵션의 token 한 줄을 여기에.
# 사용 안 하면 모두 주석 유지. 활성화 시 위 로컬 CHROMA_PORT/POSTGRES_URL 과 충돌
# 주의 — dotenv 가 후순위 값을 덮어쓰므로 한 환경만 활성화.
# CLOUDFLARED_TOKEN=<your-cloudflared-tunnel-token>
# POSTGRES_USER=cpia
# POSTGRES_PASSWORD=<your-postgres-password>
# POSTGRES_DB=cpia
# POSTGRES_PORT=5532
# CHROMA_PORT=5533
